<?xml version="1.0" encoding="ASCII"?>
<organization:Organization xmlns:organization="http://documentation.bonitasoft.com/organization-xml-schema/1.1">
  <users>
    <user userName="operador.municipal">
      <firstName>Operador</firstName>
      <lastName>Municipal</lastName>
      <jobTitle>Operador Municipal</jobTitle>
      <enabled>true</enabled>
      <password encrypted="false">bpm</password>
    </user>
    <user userName="coordinador.regional">
      <firstName>Coordinador</firstName>
      <lastName>Regional</lastName>
      <jobTitle>Centro Coordinador Regional</jobTitle>
      <enabled>true</enabled>
      <password encrypted="false">bpm</password>
    </user>
    <user userName="ong.cruzroja">
      <firstName>ONG</firstName>
      <lastName>Cruz Roja</lastName>
      <jobTitle>Representante de ONG</jobTitle>
      <enabled>true</enabled>
      <password encrypted="false">bpm</password>
    </user>
    <user userName="ong.bomberos">
      <firstName>ONG</firstName>
      <lastName>Bomberos Voluntarios</lastName>
      <jobTitle>Representante de ONG</jobTitle>
      <enabled>true</enabled>
      <password encrypted="false">bpm</password>
    </user>
  </users>
  <roles>
    <role name="member">
      <displayName>Member</displayName>
      <description>Rol generico -- el mapeo de actores en el proceso se hace por grupo, no por rol</description>
    </role>
  </roles>
  <groups>
    <group name="rescuesync">
      <displayName>RescueSync</displayName>
      <description>Grupo raiz de la red RescueSync para esta etapa del TP</description>
    </group>
    <group name="municipio" parentPath="/rescuesync">
      <displayName>Municipio (Operador Municipal)</displayName>
      <description>Actor de la lane Municipio -- registra emergencias y adjudica ofertas</description>
    </group>
    <group name="coordinador" parentPath="/rescuesync">
      <displayName>Centro Coordinador Regional</displayName>
      <description>Actor de la lane CCR -- genera lotes, publica convocatoria, evalua cobertura y monitorea despliegue</description>
    </group>
    <group name="ong" parentPath="/rescuesync">
      <displayName>ONG / Organismo de Rescate</displayName>
      <description>Actor de la lane ONG -- carga ofertas de ayuda y confirma finalizacion de actividades</description>
    </group>
  </groups>
  <memberships>
    <membership>
      <userName>operador.municipal</userName>
      <roleName>member</roleName>
      <groupName>municipio</groupName>
      <groupParentPath>/rescuesync</groupParentPath>
    </membership>
    <membership>
      <userName>coordinador.regional</userName>
      <roleName>member</roleName>
      <groupName>coordinador</groupName>
      <groupParentPath>/rescuesync</groupParentPath>
    </membership>
    <membership>
      <userName>ong.cruzroja</userName>
      <roleName>member</roleName>
      <groupName>ong</groupName>
      <groupParentPath>/rescuesync</groupParentPath>
    </membership>
    <membership>
      <userName>ong.bomberos</userName>
      <roleName>member</roleName>
      <groupName>ong</groupName>
      <groupParentPath>/rescuesync</groupParentPath>
    </membership>
  </memberships>
</organization:Organization>
