<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_RescueSync"
                  targetNamespace="http://rescuesync.dssd.2026"
                  exporter="RescueSync" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_RescueSync">
    <bpmn:participant id="Participant_RescueSync" name="RescueSync - Gestion Integral de la Emergencia" processRef="Process_RescueSync" />
  </bpmn:collaboration>
  <bpmn:process id="Process_RescueSync" name="Gestion Integral de la Emergencia" isExecutable="true">
    <bpmn:documentation>Proceso de orquestacion del ciclo de vida completo de una emergencia en RescueSync.
Variables de proceso esperadas (definirlas en Bonita Studio tras la importacion):
  - emergenciaId : java.lang.Long
  - municipioId : java.lang.Long
  - nivelGravedad : java.lang.String
  - ventanaOfertasISO : java.lang.String
  - coberturaCompleta : java.lang.Boolean
  - porcentajeCobertura : java.lang.Double
  - decisionCoordinador : java.lang.String
  - ofertasJson : java.lang.String
  - ongsAdjudicadas : java.lang.String
</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_RescueSync">
      <bpmn:lane id="Lane_muni" name="Municipio (Operador Municipal)">
        <bpmn:flowNodeRef>Start_emergencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_registrarEmergencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_adjudicarOfertas</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ccr" name="Centro Coordinador Regional">
        <bpmn:flowNodeRef>T_generarLotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_publicarConvocatoria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_evaluarCobertura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_curso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_monitorearEjecucion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_validarCierre</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ong" name="ONG / Organismo de Rescate">
        <bpmn:flowNodeRef>T_cargarOfertas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Bnd_ventanaOfertas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_confirmarFinalizacion</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sys" name="Sistema RescueSync (BPM / Conectores)">
        <bpmn:flowNodeRef>S_obtenerOfertas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_validarCobertura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_cobertura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_compromiso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_liberarCierre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_emergenciaCerrada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_emergencia" name="Emergencia detectada">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_registrarEmergencia" name="Registrar Emergencia">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:performer id="Perf_T_registrarEmergencia" name="OperadorMunicipal">
        <bpmn:resourceAssignmentExpression id="RAE_T_registrarEmergencia">
          <bpmn:formalExpression id="FE_T_registrarEmergencia">OperadorMunicipal</bpmn:formalExpression>
        </bpmn:resourceAssignmentExpression>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:userTask id="T_generarLotes" name="Revisar Informacion y Generar Lotes de Necesidades">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:incoming>Flow_curso_reformular</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:performer id="Perf_T_generarLotes" name="CentroCoordinador">
        <bpmn:resourceAssignmentExpression id="RAE_T_generarLotes">
          <bpmn:formalExpression id="FE_T_generarLotes">CentroCoordinador</bpmn:formalExpression>
        </bpmn:resourceAssignmentExpression>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:userTask id="T_publicarConvocatoria" name="Publicar Convocatoria y Notificar a la Red de ONGs">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:incoming>Flow_curso_ampliar</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:performer id="Perf_T_publicarConvocatoria" name="CentroCoordinador">
        <bpmn:resourceAssignmentExpression id="RAE_T_publicarConvocatoria">
          <bpmn:formalExpression id="FE_T_publicarConvocatoria">CentroCoordinador</bpmn:formalExpression>
        </bpmn:resourceAssignmentExpression>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:userTask id="T_cargarOfertas" name="Cargar Ofertas de Ayuda">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:performer id="Perf_T_cargarOfertas" name="ONG">
        <bpmn:resourceAssignmentExpression id="RAE_T_cargarOfertas">
          <bpmn:formalExpression id="FE_T_cargarOfertas">ONG</bpmn:formalExpression>
        </bpmn:resourceAssignmentExpression>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Bnd_ventanaOfertas" name="Cierre de la ventana de recepcion de ofertas" attachedToRef="T_cargarOfertas" cancelActivity="true">
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TD_Bnd_ventanaOfertas">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${ventanaOfertasISO}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="S_obtenerOfertas" name="Obtener Ofertas de la Red (GET App Local)">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S_validarCobertura" name="Validar en Sistema Nacional y Calcular Cobertura">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_cobertura" name="Se cubrieron todos los lotes?" default="Flow_cob_si">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_cob_si</bpmn:outgoing>
      <bpmn:outgoing>Flow_cob_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_evaluarCobertura" name="Evaluar Cobertura y Definir Curso de Accion">
      <bpmn:incoming>Flow_cob_no</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:performer id="Perf_T_evaluarCobertura" name="CentroCoordinador">
        <bpmn:resourceAssignmentExpression id="RAE_T_evaluarCobertura">
          <bpmn:formalExpression id="FE_T_evaluarCobertura">CentroCoordinador</bpmn:formalExpression>
        </bpmn:resourceAssignmentExpression>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_curso" name="Curso de accion" default="Flow_curso_ampliar">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_curso_ampliar</bpmn:outgoing>
      <bpmn:outgoing>Flow_curso_reformular</bpmn:outgoing>
      <bpmn:outgoing>Flow_curso_parcial</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_adjudicarOfertas" name="Adjudicar Ofertas">
      <bpmn:incoming>Flow_cob_si</bpmn:incoming>
      <bpmn:incoming>Flow_curso_parcial</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:performer id="Perf_T_adjudicarOfertas" name="OperadorMunicipal">
        <bpmn:resourceAssignmentExpression id="RAE_T_adjudicarOfertas">
          <bpmn:formalExpression id="FE_T_adjudicarOfertas">OperadorMunicipal</bpmn:formalExpression>
        </bpmn:resourceAssignmentExpression>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:serviceTask id="S_compromiso" name="Notificar Adjudicacion y Registrar Compromiso Nacional">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_monitorearEjecucion" name="Monitorear Ejecucion del Despliegue">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:performer id="Perf_T_monitorearEjecucion" name="CentroCoordinador">
        <bpmn:resourceAssignmentExpression id="RAE_T_monitorearEjecucion">
          <bpmn:formalExpression id="FE_T_monitorearEjecucion">CentroCoordinador</bpmn:formalExpression>
        </bpmn:resourceAssignmentExpression>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:userTask id="T_confirmarFinalizacion" name="Confirmar Finalizacion de Actividades">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:performer id="Perf_T_confirmarFinalizacion" name="ONG">
        <bpmn:resourceAssignmentExpression id="RAE_T_confirmarFinalizacion">
          <bpmn:formalExpression id="FE_T_confirmarFinalizacion">ONG</bpmn:formalExpression>
        </bpmn:resourceAssignmentExpression>
      </bpmn:performer>
      <bpmn:multiInstanceLoopCharacteristics id="MI_T_confirmarFinalizacion" isSequential="false" />
    </bpmn:userTask>
    <bpmn:userTask id="T_validarCierre" name="Validar Cierre Operativo Bilateral">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:performer id="Perf_T_validarCierre" name="CentroCoordinador">
        <bpmn:resourceAssignmentExpression id="RAE_T_validarCierre">
          <bpmn:formalExpression id="FE_T_validarCierre">CentroCoordinador</bpmn:formalExpression>
        </bpmn:resourceAssignmentExpression>
      </bpmn:performer>
    </bpmn:userTask>
    <bpmn:serviceTask id="S_liberarCierre" name="Liberar Recursos y Notificar Cierre">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_emergenciaCerrada" name="Emergencia cerrada">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_emergencia" targetRef="T_registrarEmergencia" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="T_registrarEmergencia" targetRef="T_generarLotes" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="T_generarLotes" targetRef="T_publicarConvocatoria" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="T_publicarConvocatoria" targetRef="T_cargarOfertas" />
    <bpmn:sequenceFlow id="Flow_05" name="Ofertas cargadas" sourceRef="T_cargarOfertas" targetRef="S_obtenerOfertas" />
    <bpmn:sequenceFlow id="Flow_06" name="Vence la ventana" sourceRef="Bnd_ventanaOfertas" targetRef="S_obtenerOfertas" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="S_obtenerOfertas" targetRef="S_validarCobertura" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="S_validarCobertura" targetRef="GW_cobertura" />
    <bpmn:sequenceFlow id="Flow_cob_si" name="Si - lotes cubiertos" sourceRef="GW_cobertura" targetRef="T_adjudicarOfertas" />
    <bpmn:sequenceFlow id="Flow_cob_no" name="No - cobertura incompleta" sourceRef="GW_cobertura" targetRef="T_evaluarCobertura">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${coberturaCompleta == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="T_evaluarCobertura" targetRef="GW_curso" />
    <bpmn:sequenceFlow id="Flow_curso_ampliar" name="Ampliar y reabrir convocatoria" sourceRef="GW_curso" targetRef="T_publicarConvocatoria" />
    <bpmn:sequenceFlow id="Flow_curso_reformular" name="Reformular lotes" sourceRef="GW_curso" targetRef="T_generarLotes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisionCoordinador == &quot;REFORMULAR&quot;}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_curso_parcial" name="Continuar con cobertura parcial" sourceRef="GW_curso" targetRef="T_adjudicarOfertas">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisionCoordinador == &quot;PARCIAL&quot;}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="T_adjudicarOfertas" targetRef="S_compromiso" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="S_compromiso" targetRef="T_monitorearEjecucion" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T_monitorearEjecucion" targetRef="T_confirmarFinalizacion" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="T_confirmarFinalizacion" targetRef="T_validarCierre" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="T_validarCierre" targetRef="S_liberarCierre" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="S_liberarCierre" targetRef="End_emergenciaCerrada" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_RescueSync">
    <bpmndi:BPMNPlane id="BPMNPlane_RescueSync" bpmnElement="Collaboration_RescueSync">
      <bpmndi:BPMNShape id="Shape_Participant" bpmnElement="Participant_RescueSync" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2830" height="720" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_muni" bpmnElement="Lane_muni" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2800" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_ccr" bpmnElement="Lane_ccr" isHorizontal="true">
        <dc:Bounds x="190" y="260" width="2800" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_ong" bpmnElement="Lane_ong" isHorizontal="true">
        <dc:Bounds x="190" y="440" width="2800" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_sys" bpmnElement="Lane_sys" isHorizontal="true">
        <dc:Bounds x="190" y="620" width="2800" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_emergencia" bpmnElement="Start_emergencia">
        <dc:Bounds x="242" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="200" y="194" width="120" height="26" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_registrarEmergencia" bpmnElement="T_registrarEmergencia">
        <dc:Bounds x="360" y="134" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_generarLotes" bpmnElement="T_generarLotes">
        <dc:Bounds x="520" y="314" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_publicarConvocatoria" bpmnElement="T_publicarConvocatoria">
        <dc:Bounds x="680" y="314" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_cargarOfertas" bpmnElement="T_cargarOfertas">
        <dc:Bounds x="840" y="494" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Bnd_ventanaOfertas" bpmnElement="Bnd_ventanaOfertas">
        <dc:Bounds x="942" y="548" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="840" y="590" width="120" height="26" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_obtenerOfertas" bpmnElement="S_obtenerOfertas">
        <dc:Bounds x="1000" y="674" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_validarCobertura" bpmnElement="S_validarCobertura">
        <dc:Bounds x="1160" y="674" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_cobertura" bpmnElement="GW_cobertura">
        <dc:Bounds x="1355" y="685" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1320" y="741" width="120" height="26" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_evaluarCobertura" bpmnElement="T_evaluarCobertura">
        <dc:Bounds x="1480" y="314" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_curso" bpmnElement="GW_curso">
        <dc:Bounds x="1675" y="325" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1640" y="381" width="120" height="26" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_adjudicarOfertas" bpmnElement="T_adjudicarOfertas">
        <dc:Bounds x="1800" y="134" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_compromiso" bpmnElement="S_compromiso">
        <dc:Bounds x="1960" y="674" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_monitorearEjecucion" bpmnElement="T_monitorearEjecucion">
        <dc:Bounds x="2120" y="314" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_confirmarFinalizacion" bpmnElement="T_confirmarFinalizacion">
        <dc:Bounds x="2280" y="494" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_T_validarCierre" bpmnElement="T_validarCierre">
        <dc:Bounds x="2440" y="314" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_liberarCierre" bpmnElement="S_liberarCierre">
        <dc:Bounds x="2600" y="674" width="120" height="72" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_emergenciaCerrada" bpmnElement="End_emergenciaCerrada">
        <dc:Bounds x="2802" y="692" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2760" y="734" width="120" height="26" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_01" bpmnElement="Flow_01">
        <di:waypoint x="278" y="170" />
        <di:waypoint x="360" y="170" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_02" bpmnElement="Flow_02">
        <di:waypoint x="480" y="170" />
        <di:waypoint x="500" y="170" />
        <di:waypoint x="500" y="350" />
        <di:waypoint x="520" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_03" bpmnElement="Flow_03">
        <di:waypoint x="640" y="350" />
        <di:waypoint x="680" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_04" bpmnElement="Flow_04">
        <di:waypoint x="800" y="350" />
        <di:waypoint x="820" y="350" />
        <di:waypoint x="820" y="530" />
        <di:waypoint x="840" y="530" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_05" bpmnElement="Flow_05">
        <di:waypoint x="960" y="530" />
        <di:waypoint x="980" y="530" />
        <di:waypoint x="980" y="710" />
        <di:waypoint x="1000" y="710" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="925" y="680" width="110" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_06" bpmnElement="Flow_06">
        <di:waypoint x="900" y="584" />
        <di:waypoint x="900" y="710" />
        <di:waypoint x="1000" y="710" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="845" y="680" width="110" height="24" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_07" bpmnElement="Flow_07">
        <di:waypoint x="1120" y="710" />
        <di:waypoint x="1160" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_08" bpmnElement="Flow_08">
        <di:waypoint x="1280" y="710" />
        <di:waypoint x="1355" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_cob_si" bpmnElement="Flow_cob_si">
        <di:waypoint x="1405" y="710" />
        <di:waypoint x="1602" y="710" />
        <di:waypoint x="1602" y="170" />
        <di:waypoint x="1800" y="170" />
